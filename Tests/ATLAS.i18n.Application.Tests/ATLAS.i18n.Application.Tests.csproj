<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ATLAS.i18n.Application.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ATLAS.i18n.Application\ATLAS.i18n.Application.csproj" />
    <ProjectReference Include="..\..\src\ATLAS.i18n.Domain\ATLAS.i18n.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit"                          Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio"     Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions"               Version="7.*" />
    <PackageReference Include="Moq"                            Version="4.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk"        Version="17.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
  </ItemGroup>

</Project>
