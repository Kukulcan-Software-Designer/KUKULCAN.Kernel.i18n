<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ATLAS.i18n.Application</RootNamespace>
    <AssemblyName>ATLAS.i18n.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ATLAS.i18n.Domain\ATLAS.i18n.Domain.csproj" />
    <!--
      Atlas.SharedKernel.Infrastructure provides:
        - ValidationBehavior, LoggingBehavior, CachingBehavior, TenantBehavior (MediatR)
        - PagedResult<T>, PaginationRequest, SortOrder
        - SequentialGuid, collection/string/datetime extensions
      Atlas.SharedKernel.Domain provides Result<T>, Error, ValueObject, Guard, etc.
      Atlas.SharedKernel.Abstractions provides ICacheService, IUnitOfWork, ICurrentUser, etc.
    -->
    <ProjectReference Include="..\..\..\SharedKernel\Atlas.SharedKernel.Infrastructure\Atlas.SharedKernel.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FluentValidation for command/query validators -->
    <PackageReference Include="FluentValidation"                                  Version="11.*" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions"    Version="11.*" />
    <!-- MediatR is already transitively available via SharedKernel.Infrastructure -->
  </ItemGroup>

</Project>
