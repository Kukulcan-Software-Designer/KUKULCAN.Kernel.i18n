<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ATLAS.Kernel.i18n.Domain</RootNamespace>
    <AssemblyName>ATLAS.Kernel.i18n.Domain</AssemblyName>
  </PropertyGroup>

    <!--
    ATLAS.Kernel.i18n.Domain only depends on Atlas.Kernel.Domain.
    No framework packages here — pure domain logic.
  -->
    <ItemGroup>
    <PackageReference Include="ATLAS.Kernel" Version="2.0.3" />
  </ItemGroup>

</Project>
