{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=atlas_i18n;Username=atlas;Password=atlas_pass;",
    "Redis": "localhost:6379,abortConnect=false"
  },

  "Atlas": {
    "Database": {
      "Provider": "PostgreSql",
      "ConnectionString": "Host=localhost;Port=5432;Database=atlas_i18n;Username=atlas;Password=atlas_pass;",
      "CommandTimeoutSeconds": 30,
      "EnableSensitiveDataLogging": false,
      "EnableDetailedErrors": false,
      "Retry": {
        "Enabled": true,
        "MaxRetryCount": 3,
        "MaxRetryDelaySeconds": 30
      },
      "Pool": {
        "Enabled": true,
        "MinSize": 5,
        "MaxSize": 100
      },
      "Migration": {
        "AutoMigrateOnStartup": false,
        "SeedDataOnStartup": true
      }
    }
  },

  "Database": {
    "AutoMigrate": false
  },

  "Jwt": {
    "SecretKey": "CHANGE_THIS_TO_A_STRONG_SECRET_KEY_IN_PRODUCTION_MIN_32_CHARS",
    "Issuer": "ATLAS",
    "Audience": "ATLAS.i18n"
  },

  "AllowedHosts": "*"
}
