<Project>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <GeneratePackageOnBuild Condition="'$(Configuration)'=='Release'">true</GeneratePackageOnBuild>
        <SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>
        <PackageId>$(AssemblyName)</PackageId>
        <Version>$(VersionPrefix)</Version>
        <Authors>KRATOS Design Systems</Authors>
        <Company>KRATOS Design Systems</Company>
        <Copyright>GPL 2026 Kratos Software Design</Copyright>
        <PackageProjectUrl>https://www.kratos.com/ATLAS</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageOutputPath>$(SolutionDir)NuGet\</PackageOutputPath>
        <PackageTags>atlas;erp;ddd;kernel;database;efcore;infrastructure</PackageTags>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <RepositoryUrl>https://github.com/Potestaris/ATLAS.Kernel</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Description>**ATLAS** platform internationalization microservice. Provides:

- **Translations**: lookup by unique code (`MODULE + NNNN`) and language, with automatic fallback to English.
- **Locale configuration**: date and time formats, decimal and thousands separators.
- **Currency formats**: symbol, position, spacing, decimals, and negative pattern.
        </Description>
    </PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<None Include="$(SolutionDir)LICENSE" Pack="true" PackagePath="\" />
		<None Include="$(SolutionDir)README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
