{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/atlas-i18n-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },

  "ConnectionStrings": {
    "I18nDb": "Host=localhost;Port=5432;Database=atlas_i18n;Username=atlas;Password=atlas_pass;",
    "Redis": "localhost:6379,abortConnect=false"
  },

  "Jwt": {
    "SecretKey": "CHANGE_THIS_TO_A_STRONG_SECRET_KEY_IN_PRODUCTION_MIN_32_CHARS",
    "Issuer": "ATLAS",
    "Audience": "ATLAS.i18n",
    "ExpiryMinutes": 60
  },

  "Database": {
    "AutoMigrate": true
  },

  "AllowedHosts": "*"
}
